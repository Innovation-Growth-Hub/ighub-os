{
  "name": "@ighub/db",
  "version": "0.1.0",
  "private": true,
  "description": "Drizzle schema (MySQL 8), migrations and seed for IGHubOs.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "migrations"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.check.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@ighub/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "mysql2": "^3.24.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "better-auth": "^1.7.18",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
