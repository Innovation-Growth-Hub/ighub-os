# Copy to .env (never commit .env). Validated at boot by src/config/env.ts.

NODE_ENV=development
PORT=4000

# mysql://USER:PASSWORD@HOST:PORT/DATABASE  (see packages/db/sql/create-local-databases.sql)
DATABASE_URL=mysql://ighubos:CHANGE_ME@localhost:3306/ighubos_dev
# Used by `pnpm test:e2e` (wiped and migrated by the tests)
TEST_DATABASE_URL=mysql://ighubos:CHANGE_ME@localhost:3306/ighubos_test

# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=replace-with-32-plus-random-characters
# Public URL the browser uses for auth (the web origin, because Next rewrites /api/* to this API)
BETTER_AUTH_URL=http://localhost:3000
# Web app origin(s), comma separated. Requests from anywhere else are refused (CSRF).
WEB_ORIGINS=http://localhost:3000
