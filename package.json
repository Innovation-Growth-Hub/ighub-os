{
  "name": "ighubos",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @ighub/db db:generate",
    "db:migrate": "pnpm --filter @ighub/db db:migrate",
    "db:seed": "pnpm --filter @ighub/db db:seed"
  },
  "devDependencies": {
    "turbo": "^2.11.10"
  }
}
